					{
						"name": "x-api-version",
						"in": "header",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "200 Job Created",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"code": {
											"type": "integer"
										},
										"transaction_id": {
											"type": "string"
										},
										"data": {
											"type": "object",
											"properties": {
												"@entity": {
													"type": "string"
												},
												"job_id": {
													"type": "string"
												},
												"gstin": {
													"type": "string"
												},
												"year": {
													"type": "integer"
												},
												"month": {
													"type": "integer"
												},
												"filing_preference": {
													"type": "string"
												},
												"reconciliation_criteria": {
													"type": "string"
												},
												"status": {
													"type": "string"
												},
												"gstr_2b_url": {
													"type": "string",
													"format": "uri"
												},
												"purchase_ledger_url": {
													"type": "string",
													"format": "uri"
												},
												"created_at": {
													"type": "string"
												}
											}
										},
										"timestamp": {
											"type": "string"
										}
									}
								}
							}
						}
					}
				},
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"@entity": {
										"type": "string"
									},
									"gstin": {
										"type": "string"
									},
									"year": {
										"type": "string"
									},
									"month": {
										"type": "string"
									},
									"reconciliation_criteria": {
										"type": "string"
									}
								}
							}
						}
					}
				}
			},
			"get": {
				"summary": "Reconcile GSTR-2B Job Status",
				"tags": ["GSTR-2B Reconciliation"],
				"parameters": [
					{
						"name": "job_id",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "authorization",
						"in": "header",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "x-api-key",
						"in": "header",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "x-api-version",
						"in": "header",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"default": {
						"description": "200 Reconciliation Job Done",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		}
	}
}
