              "type": "string",
              "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$"
            }
          },
          {
            "name": "consent",
            "in": "query",
            "description": "Explicit consent from the end user to verify their PAN details. Must be passed as \"Y\" or \"y\" to proceed.",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Y",
                "y"
              ]
            }
          },
          {
            "name": "reason",
