                          "street": "Main Cross 3rd",
                          "city": "Bengaluru",
                          "state": "Karnataka",
                          "pincode": 581615,
                          "country": "India"
                        }
                      }
                    }
                  },
                  "successful response for company": {
                    "summary": "Successful response for company",
                    "value": {
                      "code": 200,
                      "timestamp": 1717082916254,
                      "transaction_id": "0ef44ca0-ca3d-4a8d-8936-fb92ad63cedf",
                      "data": {
                        "@entity": "in.co.sandbox.kyc.pan_search.response",
                        "status": "valid",
                        "pan": "XXXCX1234A",
                        "full_name": "JOHN DOE TECHNOLOGIES PRIVATE LIMITED",
                        "category": "Company",
                        "gender": null,
                        "date_of_birth": "02-10-2008",
                        "masked_aadhaar_number": null,
                        "email": "company@email.com",
                        "mobile_number": "111111111",
                        "aadhaar_seeding_status": "na",
                        "first_name": "JOHN DOE TECHNOLOGIES PRIVATE LIMITED",
                        "last_name": null,
                        "middle_name": null,
                        "address": {
                          "@entity": "in.co.sandbox.kyc.pan_search.address",
                          "full_address": "Quarter - A, Block - B Sample Area, ABC Street MUMBAI MAHARASTRA INDIA 700011",
                          "street": "ABC Street",
                          "city": "MUMBAI",
                          "state": "MAHARASTRA",
                          "pincode": 700011,
                          "country": "India"
                        }
                      }
                    }
                  },
                  "invalid pan": {
                    "summary": "Invalid PAN",
                    "value": {
                      "code": 200,
                      "timestamp": 1763727760000,
                      "transaction_id": "c0e6f784-c0ec-4375-8b60-017d7570f59c",
                      "data": {
                        "@entity": "in.co.sandbox.kyc.pan_search.response",
                        "pan": "XXXFX1234J",
                        "category": "Firm",
                        "status": "invalid"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "422 - Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "timestamp",
                    "transaction_id",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "HTTP status code of the response."
                    },
                    "timestamp": {
                      "type": "integer",
                      "description": "Unix timestamp in milliseconds indicating when the response was generated."
                    },
                    "transaction_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier for this API transaction, used for support and traceability."
                    },
                    "message": {
                      "type": "string",
                      "description": "Human-readable description of the validation error."
                    }
                  }
                },
                "examples": {
                  "invalid pan pattern": {
                    "summary": "Invalid PAN pattern",
                    "value": {
                      "code": 422,
                      "timestamp": 1763727760000,
                      "transaction_id": "65a16945-6293-47d9-931d-6e790fab226f",
