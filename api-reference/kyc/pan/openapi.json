  "paths": {
    "/kyc/pan/search": {
      "post": {
        "summary": "Search PAN",
        "operationId": "searchPAN",
        "tags": [
          "PAN"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "JWT access token",
            "required": true,
            "example": "{{access_token}}",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "description": "API key for identification",
            "required": true,
            "example": "{{api_key}}",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-api-version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-accept-cache",
            "in": "header",
            "required": false,
            "description": "Pass true to accept the cached response. If the header is not passed, or if false is sent as the value, the request will hit the origin.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "@entity",
                  "pan",
                  "consent",
                  "reason"
                ],
                "properties": {
                  "@entity": {
                    "type": "string",
                    "enum": [
                      "in.co.sandbox.kyc.pan_search.request"
                    ],
                    "description": "Entity type identifier for the PAN search request."
                  },
                  "pan": {
                    "type": "string",
                    "description": "10-character Permanent Account Number to look up. Must follow the standard PAN format: five letters, four digits, one letter.",
                    "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
                    "minLength": 10,
                    "maxLength": 10
                  },
                  "consent": {
                    "type": "string",
                    "enum": [
                      "Y",
                      "y"
                    ],
                    "description": "Explicit consent from the end user to look up their PAN details. Must be passed as \"Y\" or \"y\" to proceed."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Purpose for initiating the PAN search, such as identity verification or KYC compliance. Used for audit and compliance traceability.",
                    "minLength": 1
                  }
                }
              },
              "example": {
                "@entity": "in.co.sandbox.kyc.pan_search.request",
                "pan": "XXXPX1234A",
                "consent": "y",
                "reason": "For KYC"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200 - OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "timestamp",
                    "transaction_id",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "HTTP status code of the response."
                    },
                    "timestamp": {
                      "type": "integer",
                      "description": "Unix timestamp in milliseconds indicating when the response was generated."
                    },
                    "transaction_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier for this API transaction, used for support and traceability."
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "@entity",
                        "pan",
                        "status",
                        "category"
                      ],
                      "properties": {
                        "@entity": {
                          "type": "string",
                          "enum": [
                            "in.co.sandbox.kyc.pan_search.response"
                          ],
                          "description": "Entity type identifier for the PAN search response."
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "valid",
                            "invalid"
                          ],
                          "description": "Validity status of the PAN as reported by the income tax authority."
                        },
                        "message": {
                          "type": "string",
                          "nullable": true,
                          "description": "Additional context about the result, typically present when status is invalid."
                        },
                        "pan": {
                          "type": "string",
                          "description": "The queried PAN.",
                          "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
                          "minLength": 10,
                          "maxLength": 10
                        },
                        "full_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Full name of the PAN holder as registered with the income tax authority."
                        },
                        "name_pan_card": {
                          "type": "string",
                          "nullable": true,
                          "description": "Name as printed on the PAN card. May differ from full_name, which reflects the income tax database record."
                        },
                        "category": {
                          "type": "string",
                          "enum": [
                            "Individual",
                            "Company",
                            "Firm",
                            "HUF",
                            "Trust",
                            "Government",
                            "Body of Individuals",
                            "Association of Persons",
                            "Local Authority",
                            "Artificial Judicial Person",
                            "Pan not Available"
                          ],
                          "description": "Category of the PAN holder, derived from the fourth character of the PAN."
                        },
                        "gender": {
                          "type": "string",
                          "nullable": true,
                          "description": "Gender of the PAN holder. Returns null for non-individual categories such as companies and firms."
                        },
                        "date_of_birth": {
                          "type": "string",
                          "nullable": true,
                          "description": "Date of birth of an individual, or date of incorporation for a company or firm. Format: DD-MM-YYYY."
                        },
                        "masked_aadhaar_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "Aadhaar number with the first eight digits masked, shown only when Aadhaar is linked to the PAN. Returns null for non-individual categories."
                        },
                        "email": {
                          "type": "string",
                          "format": "email",
                          "nullable": true,
                          "description": "Email address registered with the PAN."
                        },
                        "mobile_number": {
                          "type": "string",
                          "nullable": true,
                          "description": "Mobile number registered with the PAN."
                        },
                        "first_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "First name of the PAN holder. For non-individual categories, this field contains the full registered name."
                        },
                        "middle_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Middle name of the PAN holder. Returns null when not available or for non-individual categories."
                        },
                        "last_name": {
                          "type": "string",
                          "nullable": true,
                          "description": "Last name of the PAN holder. Returns null for non-individual categories."
                        },
                        "aadhaar_seeding_status": {
                          "type": "string",
                          "enum": [
                            "y",
                            "n",
                            "na"
                          ],
                          "description": "Indicates whether the PAN is linked to an Aadhaar number. \"y\" means linked, \"n\" means not linked, \"na\" means not applicable for non-individual categories."
                        },
                        "address": {
                          "type": "object",
                          "nullable": true,
                          "description": "Address of the PAN holder as registered with the income tax authority.",
                          "properties": {
                            "@entity": {
                              "type": "string",
                              "enum": [
                                "in.co.sandbox.kyc.pan_search.address"
                              ],
                              "description": "Entity type identifier for the address object."
                            },
                            "full_address": {
                              "type": "string",
                              "nullable": true,
                              "description": "Complete address as a single formatted string."
                            },
                            "street": {
                              "type": "string",
                              "nullable": true,
                              "description": "Street or locality component of the address."
                            },
                            "city": {
                              "type": "string",
                              "nullable": true,
                              "description": "City component of the address."
                            },
                            "state": {
                              "type": "string",
                              "nullable": true,
                              "description": "State component of the address."
                            },
                            "pincode": {
                              "type": "integer",
                              "nullable": true,
                              "description": "6-digit postal code."
                            },
                            "country": {
                              "type": "string",
                              "nullable": true,
                              "description": "Country component of the address."
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "successful response for individual": {
                    "summary": "Successful response for individual",
                    "value": {
                      "code": 200,
                      "timestamp": 1763727760000,
                      "transaction_id": "88ca194e-7853-4951-a239-26bb5b1fee67",
                      "data": {
                        "@entity": "in.co.sandbox.kyc.pan_search.response",
                        "status": "valid",
                        "pan": "XXXPX1234A",
                        "full_name": "AARAV SHARMA",
                        "category": "Individual",
