{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "PAN verification workbook",
  "description": "Bulk PAN verification results from TRACES.",
  "properties": {
    "@entity": {
      "type": "string",
      "enum": [
        "workbook"
      ]
    },
    "name": {
      "type": "string",
      "enum": [
        "pan_verification_workbook"
      ]
    },
    "sheets": {
      "type": "array",
      "description": "One payee sheet containing PAN verification results.",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "title": "Payee sheet",
            "description": "PAN verification results for submitted payees.",
            "properties": {
              "@entity": {
                "type": "string",
                "enum": [
                  "sheet"
                ]
              },
              "name": {
                "type": "string",
                "enum": [
                  "payee_sheet"
                ]
              },
              "blocks": {
                "type": "array",
                "description": "One payee table with serial numbers, PANs, and verification statuses.",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "title": "Payee table",
                      "description": "Submitted PANs included in the TRACES verification report.",
                      "properties": {
                        "@entity": {
                          "type": "string",
                          "enum": [
                            "table"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "enum": [
                            "payee_table"
                          ]
                        },
                        "header": {
                          "type": "array",
                          "description": "Column names in the required order: sr_no, pan, pan_status.",
                          "items": [
                            {
                              "type": "string",
                              "enum": [
                                "sr_no"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "pan"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "pan_status"
                              ]
                            }
                          ],
                          "additionalItems": false,
                          "minItems": 3,
                          "maxItems": 3
                        },
                        "rows": {
                          "type": "array",
                          "description": "Verification results in the same column order as the header. Empty when no submitted PANs have results.",
                          "items": {
                            "type": "array",
                            "examples": [[1, "ABCPD1234E", "Valid and Operative"]],
                            "items": [
                              {
                                "type": "integer",
                                "title": "Serial number",
                                "minimum": 1,
                                "description": "Serial number from this PAN's first input row.",
                                "examples": [1]
                              },
                              {
                                "type": "string",
                                "title": "PAN",
                                "description": "Payee PAN included in the verification report.",
                                "examples": ["ABCPD1234E"]
                              },
                              {
                                "type": "string",
                                "title": "PAN status",
                                "description": "PAN validity and operative status reported by TRACES.",
                                "enum": [
                                  "Valid and Operative",
                                  "Valid and Inoperative",
                                  "Valid",
                                  "Inactive",
                                  "Invalid"
                                ],
                                "examples": ["Valid and Operative"]
                              }
                            ],
                            "additionalItems": false,
                            "minItems": 3,
                            "maxItems": 3
                          }
                        }
                      },
                      "required": [
                        "@entity",
                        "name",
                        "header",
                        "rows"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "@entity",
              "name",
              "blocks"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "@entity",
    "name",
    "sheets"
  ]
}
