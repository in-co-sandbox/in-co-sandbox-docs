{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Payee workbook",
  "description": "Payees for bulk PAN verification through TRACES.",
  "properties": {
    "@entity": {
      "type": "string",
      "enum": [
        "workbook"
      ]
    },
    "name": {
      "type": "string",
      "enum": [
        "payee_workbook"
      ]
    },
    "sheets": {
      "type": "array",
      "description": "One payee sheet containing the PANs to verify.",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "title": "Payee sheet",
            "description": "Payee details for bulk PAN verification.",
            "properties": {
              "@entity": {
                "type": "string",
                "enum": [
                  "sheet"
                ]
              },
              "name": {
                "type": "string",
                "enum": [
                  "payee_sheet"
                ]
              },
              "blocks": {
                "type": "array",
                "description": "One payee table with serial numbers and PANs.",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "title": "Payee table",
                      "description": "Payee serial numbers and PANs to verify.",
                      "properties": {
                        "@entity": {
                          "type": "string",
                          "enum": [
                            "table"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "enum": [
                            "payee_table"
                          ]
                        },
                        "header": {
                          "type": "array",
                          "description": "Column names in the required order: sr_no, pan.",
                          "items": [
                            {
                              "type": "string",
                              "enum": [
                                "sr_no"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "pan"
                              ]
                            }
                          ],
                          "additionalItems": false,
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "rows": {
                          "type": "array",
                          "description": "Payee records in the same column order as the header.",
                          "items": {
                            "type": "array",
                            "examples": [[1, "ABCPD1234E"]],
                            "items": [
                              {
                                "type": "integer",
                                "title": "Serial number",
                                "minimum": 1,
                                "description": "Positive serial number identifying the payee.",
                                "examples": [1]
                              },
                              {
                                "type": "string",
                                "title": "PAN",
                                "description": "Permanent Account Number (PAN) of the payee.",
                                "examples": ["ABCPD1234E"]
                              }
                            ],
                            "additionalItems": false,
                            "minItems": 2,
                            "maxItems": 2
                          }
                        }
                      },
                      "required": [
                        "@entity",
                        "name",
                        "header",
                        "rows"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "@entity",
              "name",
              "blocks"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "@entity",
    "name",
    "sheets"
  ]
}
